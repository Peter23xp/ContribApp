rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── DEV MODE ──────────────────────────────────────────────────────────────
    // Firebase Auth a été supprimé (v3.0) — request.auth est toujours null.
    // Ces règles ouvrent l'accès pour débloquer le dev. À durcir avant la prod
    // (solution recommandée : custom token via Cloudflare Worker + Firebase Admin SDK).

    // ── USERS ─────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if true;
    }

    // ── PENDING REGISTRATIONS ─────────────────────────────────────────────────
    match /pending_registrations/{phoneHash} {
      allow read, write: if true;
    }

    // ── LOGIN SESSIONS & PHONE DIRECTORY ──────────────────────────────────────
    match /login_sessions/{phoneHash} {
      allow read, write: if true;
    }

    match /phone_directory/{phoneHash} {
      allow read, write: if true;
    }

    // ── OTP CODES ─────────────────────────────────────────────────────────────
    match /otp_codes/{docKey} {
      allow read, write: if true;
    }

    // ── MAIL (Firebase Trigger Email) ─────────────────────────────────────────
    match /mail/{mailId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // ── GROUPS ────────────────────────────────────────────────────────────────
    match /groups/{groupId} {
      allow read, write: if true;

      match /members/{memberId} {
        allow read, write: if true;
      }
    }

    // ── CONTRIBUTIONS ─────────────────────────────────────────────────────────
    match /contributions/{contributionId} {
      allow read, write: if true;
    }

    // ── NOTIFICATIONS ─────────────────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read, write: if true;
    }
  }
}
